# Variables de entorno (Fases 3+). En Fase 1 no se usan.
DATABASE_URL=postgres://domino:domino@localhost:5432/domino
JWT_SECRET=cambia-esto-en-produccion
PORT=3001
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001
# Email para recuperar contraseña (ej. Brevo gratis). Sin esto, /api/auth/forgot responde 503.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu-usuario-brevo
SMTP_PASS=tu-clave-smtp-brevo
SMTP_FROM=tu-email-verificado@tudominio.com
